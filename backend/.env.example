# Template only. Copy to backend/.env and fill in real values.
# Never commit backend/.env.
# After changing keys, restart uvicorn.

# --- App ---
APP_NAME=Qubrix
APP_TAGLINE=AI-powered GATE prep
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
STARTER_CREDITS=75
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:3000

# --- Database (Neon or local Postgres) ---
# Use the SQLAlchemy + psycopg3 prefix:
# postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require

# --- Google OAuth ---
# Authorized redirect URI must be exactly:
# http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI / LLM ---
# openai | azure_openai | stub
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

# Azure OpenAI — only if AI_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# --- OCR for handwritten sheets ---
# stub | vision_llm | azure
OCR_PROVIDER=stub
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- File storage ---
# local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=

# --- Optional jobs / cache ---
REDIS_URL=redis://localhost:6379/0

# --- Langfuse (LLM + agent tracing) ---
# Leave keys empty to disable. Dashboard: https://cloud.langfuse.com (or your region)
# Regions e.g. https://us.cloud.langfuse.com , https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Dodo Payments ---
# test_mode | live_mode
# Test key from Developer → API. Never commit the real key.
# Webhook signing secret from Developer → Webhooks. Never commit the real secret.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER=pdt_0NovD9ndMgscHwaOp8Jj2
DODO_PRODUCT_FOCUS=pdt_0NovDd3muM42r4FhEhaOv
DODO_PRODUCT_INTENSIVE=pdt_0NovDm2pyt3Uz749W0wgv
